android_app {
    name: "LenovoParts",
    certificate: "platform",
    srcs: [
        "src/**/*.java",
        "src/**/*.kt", 
    ],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "SettingsLib",
    ],
}