<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/stylus_title">

    <SwitchPreferenceCompat
        android:key="stylus_switch_key"
        android:defaultValue="false"
        android:title="@string/stylus_switch_title"
        android:summary="@string/stylus_switch_summary"/>

    <SwitchPreferenceCompat
        android:key="auto_panel_direction_key"
        android:defaultValue="true"
        android:title="@string/auto_panel_direction_title"
        android:summary="@string/auto_panel_direction_summary"/>

    <PreferenceCategory
        android:title="@string/palm_rejection_category">

        <Preference
            android:key="palm_rejection_app_profiles"
            android:title="@string/palm_rejection_app_profiles_title"
            android:summary="@string/palm_rejection_app_profiles_summary"/>

    </PreferenceCategory>

</PreferenceScreen>
